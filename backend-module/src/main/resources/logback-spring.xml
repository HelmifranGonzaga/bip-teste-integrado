<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        LOG_PATH é populado pela propriedade Spring `logging.file.path` (application.yml).
        Caso esteja ausente (ex.: testes), usamos `logs` como fallback para evitar
        o appender criar a pasta literal "LOG_PATH_IS_UNDEFINED".
    -->
    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_DIR}/desafio-bip.log}"/>

    <!-- Console Appender (Development) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"desafio-bip","version":"0.0.1"}</customFields>
        </encoder>
    </appender>

    <!-- File Appender (JSON rolling file) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"desafio-bip","version":"0.0.1","environment":"${ENVIRONMENT:-development}"}</customFields>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/spring-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Levels -->
    <logger name="com.example" level="DEBUG"/>
    <logger name="org.springframework.security" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
